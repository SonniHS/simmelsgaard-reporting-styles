  "$extensions": {
    "report-styles": {
      "meta": {
        "id": "ibcs",
        "label": "IBCS",
        "persona": "for the CFO",
        "summary": "Notation first: white paper, scenario patterns, dense pages, no decoration. The reference every other style reconciles to.",
        "brandSlot": "color.*.accent.primary, typography.family.text"
      },
      "chart": {
        "scenarioEncoding": "pattern",
        "gridlines": "none",
        "timeSeries": "columns",
        "variance": "tiers",
        "structure": "bars",
        "kpi": "card",
        "allowed": [],
        "onRequest": [],
        "banned": [
          "pie",
          "ring",
          "gauge",
          "funnel",
          "radar",
          "traffic-light",
          "pseudo-3d",
          "waffle",
          "pictogram"
        ],
        "relaxes": [
          {
            "rule": "SI 2.1",
            "what": "Cards with rounded corners and a light grey page, for UI chrome only; no frames inside charts or tables.",
            "why": "App chrome only; notation inside charts and tables stays IBCS."
          },
          {
            "rule": "SI 1.2",
            "what": "A dark theme (charcoal page and cards) when the reader picks dark.",
            "why": "Reader preference and dark app shells; the ibcs-dark derivation keeps the notation (AC solid, PY lighter, PL outlined, FC hatched) and the impact hue families.",
            "condition": "Light is the default for print and for anything shared as a document."
          }
        ]
      }
    }
  }
