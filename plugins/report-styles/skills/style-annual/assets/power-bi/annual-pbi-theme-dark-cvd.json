{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.157.json",
  "name": "annual-pbi-theme-dark-cvd",
  "dataColors": [
    "#CDB6E6",
    "#5A4D6A",
    "#ACACAC",
    "#303030"
  ],
  "good": "#4CC2D0",
  "bad": "#F17A6C",
  "neutral": "#7EA6F0",
  "maximum": "#CDB6E6",
  "center": "#5A4D6A",
  "minimum": "#221C2B",
  "foreground": "#F0EBF5",
  "foregroundNeutralSecondary": "#B2A8BF",
  "background": "#221C2B",
  "backgroundLight": "#221C2B",
  "secondaryBackground": "#17131D",
  "tableAccent": "#CDB6E6",
  "hyperlink": "#E3B25A",
  "visitedHyperlink": "#E3B25A",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Light",
      "fontSize": 33,
      "color": "#F0EBF5"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#F0EBF5"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 10,
      "color": "#F0EBF5"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#F0EBF5"
    },
    "largeTitle": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 16,
      "color": "#F0EBF5"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#221C2B"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": false,
            "color": {
              "solid": {
                "color": "#352C41"
              }
            },
            "radius": 4
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12,
            "fontColor": {
              "solid": {
                "color": "#F0EBF5"
              }
            },
            "bold": false,
            "alignment": "left"
          }
        ],
        "subTitle": [
          {
            "show": true,
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "fontColor": {
              "solid": {
                "color": "#B2A8BF"
              }
            }
          }
        ],
        "labels": [
          {
            "show": true,
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "color": {
              "solid": {
                "color": "#F0EBF5"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "gridlineShow": false,
            "showAxisTitle": false,
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#B2A8BF"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "show": false,
            "gridlineShow": false,
            "gridlineColor": {
              "solid": {
                "color": "#17131D"
              }
            },
            "showAxisTitle": false,
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#B2A8BF"
              }
            }
          }
        ],
        "legend": [
          {
            "show": false,
            "fontFamily": "Segoe UI",
            "fontSize": 10
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#17131D"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#17131D"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}
