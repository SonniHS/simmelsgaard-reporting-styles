{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.157.json",
  "name": "contrast-pbi-theme-dark",
  "dataColors": [
    "#FFFFFF",
    "#9A9A9A",
    "#D6D6D6",
    "#FFFFFF"
  ],
  "good": "#5BE38F",
  "bad": "#FF8A8A",
  "neutral": "#8EC2FF",
  "maximum": "#FFFFFF",
  "center": "#9A9A9A",
  "minimum": "#000000",
  "foreground": "#FFFFFF",
  "foregroundNeutralSecondary": "#D6D6D6",
  "background": "#000000",
  "backgroundLight": "#000000",
  "secondaryBackground": "#000000",
  "tableAccent": "#FFFFFF",
  "hyperlink": "#FFD60A",
  "visitedHyperlink": "#FFD60A",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Bold",
      "fontSize": 27,
      "color": "#FFFFFF"
    },
    "title": {
      "fontFace": "Segoe UI Bold",
      "fontSize": 14,
      "color": "#FFFFFF"
    },
    "header": {
      "fontFace": "Segoe UI Bold",
      "fontSize": 11,
      "color": "#FFFFFF"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 11,
      "color": "#FFFFFF"
    },
    "largeTitle": {
      "fontFace": "Segoe UI Bold",
      "fontSize": 16,
      "color": "#FFFFFF"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#000000"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": false,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "radius": 4
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontFamily": "Segoe UI Bold",
            "fontSize": 14,
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "bold": false,
            "alignment": "left"
          }
        ],
        "subTitle": [
          {
            "show": true,
            "fontFamily": "Segoe UI",
            "fontSize": 11,
            "fontColor": {
              "solid": {
                "color": "#D6D6D6"
              }
            }
          }
        ],
        "labels": [
          {
            "show": true,
            "fontFamily": "Segoe UI",
            "fontSize": 11,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "gridlineShow": false,
            "showAxisTitle": false,
            "fontFamily": "Segoe UI",
            "fontSize": 11,
            "labelColor": {
              "solid": {
                "color": "#D6D6D6"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "show": false,
            "gridlineShow": false,
            "gridlineColor": {
              "solid": {
                "color": "#000000"
              }
            },
            "showAxisTitle": false,
            "fontFamily": "Segoe UI",
            "fontSize": 11,
            "labelColor": {
              "solid": {
                "color": "#D6D6D6"
              }
            }
          }
        ],
        "legend": [
          {
            "show": false,
            "fontFamily": "Segoe UI",
            "fontSize": 11
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#000000"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#000000"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}
