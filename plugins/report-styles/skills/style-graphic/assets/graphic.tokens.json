  "$extensions": {
    "report-styles": {
      "meta": {
        "id": "graphic",
        "label": "Graphic",
        "persona": "for Communication",
        "summary": "A newspaper data page: the key message as a serif headline, a ruled strip of four figures, a line chart with two annotations, a ruled table with inline bars.",
        "brandSlot": "color.*.accent.primary, typography.family.display"
      },
      "chart": {
        "scenarioEncoding": "pattern",
        "gridlines": "faint",
        "timeSeries": "editorial-line",
        "variance": "annotations",
        "structure": "table-bars",
        "kpi": "figure-strip",
        "allowed": [],
        "onRequest": [],
        "banned": [
          "pie",
          "ring",
          "gauge",
          "funnel",
          "radar",
          "traffic-light",
          "pseudo-3d",
          "area-scaled-icons",
          "truncated-axis",
          "waffle",
          "pictogram"
        ],
        "relaxes": [
          {
            "rule": "SI 1.2",
            "what": "An off-white paper page (dark: warm black) with hairline rules instead of white cards.",
            "why": "The editorial look of a newspaper data page; charts and tables sit directly on the page."
          },
          {
            "rule": "SI 2.3",
            "what": "A serif display face for the headline (the key message).",
            "why": "Editorial voice; labels and figures stay in a plain sans with tabular figures."
          },
          {
            "rule": "CO 1.1",
            "what": "The key message as a 32 px headline; figures 34 px.",
            "why": "Read on intranet pages and in town-hall slides.",
            "condition": "A figure only where it carries something the headline lacks."
          },
          {
            "rule": "SI 3.1",
            "what": "Faint horizontal gridlines on the line chart, value labels only at the line ends and in the annotations.",
            "why": "Newspaper convention for a 12-point line; the reader reads levels off the grid.",
            "condition": "Gridlines or full data labels on a visual, never both."
          },
          {
            "rule": "CO 1.3",
            "what": "At most 3 visuals a page.",
            "why": "One story per page; detail lives in the IBCS page."
          },
          {
            "rule": "CH 4.1",
            "what": "The line chart keeps its own value scale instead of one px per unit across the page.",
            "why": "A line is read against its labelled gridlines, not by comparing lengths with the table's bars.",
            "condition": "Gridlines start at zero and are labelled; the table's inline bars share one scale among themselves; any further bars or columns of the same unit share it too."
          }
        ]
      }
    }
  }
}
