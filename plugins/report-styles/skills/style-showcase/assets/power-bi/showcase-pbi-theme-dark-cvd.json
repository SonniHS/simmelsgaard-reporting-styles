{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.157.json",
  "name": "showcase-pbi-theme-dark-cvd",
  "dataColors": [
    "#E9B44C",
    "#566174",
    "#A3A3A3",
    "#2B2B2B"
  ],
  "good": "#45C2D8",
  "bad": "#F2786A",
  "neutral": "#6EA6FA",
  "maximum": "#E9B44C",
  "center": "#566174",
  "minimum": "#151B26",
  "foreground": "#E8ECF2",
  "foregroundNeutralSecondary": "#9AA4B4",
  "background": "#151B26",
  "backgroundLight": "#151B26",
  "secondaryBackground": "#0E131C",
  "tableAccent": "#E9B44C",
  "hyperlink": "#E9B44C",
  "visitedHyperlink": "#E9B44C",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 20,
      "color": "#E8ECF2"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 10,
      "color": "#E8ECF2"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 9,
      "color": "#E8ECF2"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 9,
      "color": "#E8ECF2"
    },
    "largeTitle": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 15,
      "color": "#E8ECF2"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#151B26"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#232B38"
              }
            },
            "radius": 12
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10,
            "fontColor": {
              "solid": {
                "color": "#E8ECF2"
              }
            },
            "bold": false,
            "alignment": "left"
          }
        ],
        "subTitle": [
          {
            "show": true,
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "fontColor": {
              "solid": {
                "color": "#9AA4B4"
              }
            }
          }
        ],
        "labels": [
          {
            "show": true,
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "color": {
              "solid": {
                "color": "#E8ECF2"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "gridlineShow": false,
            "showAxisTitle": false,
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#9AA4B4"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#1E2632"
              }
            },
            "showAxisTitle": false,
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#9AA4B4"
              }
            }
          }
        ],
        "legend": [
          {
            "show": false,
            "fontFamily": "Segoe UI",
            "fontSize": 9
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#0E131C"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#0E131C"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}
