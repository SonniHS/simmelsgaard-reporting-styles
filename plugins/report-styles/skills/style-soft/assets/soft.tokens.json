  "$extensions": {
    "report-styles": {
      "meta": {
        "id": "soft",
        "label": "Soft",
        "persona": "for HR / People",
        "summary": "Warm page, rounded cards, calm colours, generous spacing and larger text; IBCS notation kept in a softer ink. Light: off-white and white cards; dark: warm charcoal.",
        "brandSlot": "color.*.accent.*, color.*.surface.page, typography.family.*"
      },
      "chart": {
        "scenarioEncoding": "pattern",
        "gridlines": "faint",
        "timeSeries": "soft-columns",
        "variance": "pins",
        "structure": "soft-bars",
        "kpi": "soft-tile",
        "allowed": [],
        "onRequest": [],
        "banned": [
          "pie",
          "ring",
          "gauge",
          "funnel",
          "radar",
          "traffic-light",
          "pseudo-3d",
          "pictogram"
        ],
        "relaxes": [
          {
            "rule": "SI 1.2",
            "what": "Warm off-white page behind white cards (dark: warm charcoal with slightly lighter cards).",
            "why": "Calm, familiar look for non-finance readers; charts sit on white."
          },
          {
            "rule": "SI 2.2",
            "what": "AC in a soft blue-grey ink (#4A4E69 light, #E4E0EE dark) instead of a neutral dark grey.",
            "why": "The calmer ink is the style; the tint is low-saturation, far from every impact hue, and AC stays clearly stronger than PY (checked).",
            "condition": "Never a second colour for a second series; further scenarios keep their IBCS fills."
          },
          {
            "rule": "SI 2.1",
            "what": "Rounded cards (18–24 px) with one soft shadow; bar ends rounded 4 px.",
            "why": "Chrome softness; a 4 px radius on a bar of 20+ px keeps the length readable.",
            "condition": "No radius on bars thinner than 8 px."
          },
          {
            "rule": "CO 1.1",
            "what": "Larger text (body 15, labels 13 px).",
            "why": "Readers outside finance, often on phones."
          },
          {
            "rule": "CO 2.2",
            "what": "Generous spacing; at most 4 visuals a page.",
            "why": "Lower density is the point of the style; split a dense page into two. Lower density never means filler: every element carries a message."
          },
          {
            "rule": "SI 3.1",
            "what": "Faint horizontal gridlines where data labels are dropped for readability.",
            "why": "Helps readers who do not read value labels first.",
            "condition": "Gridlines or data labels on a visual, never both."
          },
          {
            "rule": "SI 1.3",
            "what": "A short fade on entry.",
            "why": "Calm feel.",
            "condition": "Off under prefers-reduced-motion; numbers are final from the first frame."
          }
        ]
      }
    }
  }
}
